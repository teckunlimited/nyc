DATABASE_URL=postgresql://postgres:postgres@db:5432/nycdb
PORT=8000

# CORS Configuration (comma-separated list of allowed origins)
# Azure Container Apps URLs are automatically matched via regex pattern:
#   https://nyc-dev-frontend.*-*.westus.azurecontainerapps.io
#   https://nyc-staging-frontend.*-*.westus.azurecontainerapps.io
#   https://nyc-prod-frontend.*-*.westus.azurecontainerapps.io
# 
# IMPORTANT: If you have custom domains, add them here explicitly:
#   CORS_ORIGINS=http://localhost:4200,https://your-domain.com,https://www.your-domain.com
CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
